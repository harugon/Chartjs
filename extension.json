{
	"name": "ChartJs",
	"version": "2.0.0",
	"author": [
		"harugon"
	],
	"url": "",
	"namemsg": "chart-js-name",
	"descriptionmsg": "chart-js-desc",
	"license-name": "MIT",
	"type": "semantic",
	"requires": {
		"MediaWiki": ">= 1.39.0",
		"extensions": {
			"SemanticMediaWiki": ">= 4.0.0"
		}
	},

	"MessagesDirs": {
		"ChartJs": [
			"i18n"
		]
	},

	"ResourceModules": {
		"ext.chart_js": {
			"scripts": [
			  "resources/Chart.js",
			  "resources/vendor/Chart.min.js"
			],
			"styles": [
			  "resources/Chart.css"
			],
		  "dependencies": [
			"moment"
		  ],
			"targets": [ "desktop", "mobile" ]
		}
	},

	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "ChartJs"
	},

	"AutoloadNamespaces": {
		"ChartJs\\": "includes/"
	},

	"ExtensionFunctions": [
		"ChartJs\\ChartJsSetup::onExtensionFunction"
	],
	"load_composer_autoloader": true,
	"manifest_version": 2
}
